# LedgerLens Backend Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit real credentials to version control.

# -----------------------------------------------------------------------------
# Security & Authentication (REQUIRED)
# -----------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (minimum 32 characters)
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Explicit comma-separated CORS allowed origins (wildcard * is rejected when credentials are enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Cloud PostgreSQL persistence (REQUIRED for persistent production deployment).
# When DATA_BACKEND=postgres, DATABASE_URL must point to an active PostgreSQL instance.
DATA_BACKEND=postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/ledgerlens

# For hermetic local testing without external infrastructure, you may use:
# DATA_BACKEND=memory
# (Note: In-memory mode does NOT persist data across application restarts.)

# -----------------------------------------------------------------------------
# AI Providers (Optional / As Configured)
# -----------------------------------------------------------------------------
# FAL AI Key for Claude Opus document understanding
# FAL_KEY=your-fal-key-here
# FAL_ENDPOINT=https://fal.run/openrouter/router/openai/v1/chat/completions
# CLAUDE_MODEL=anthropic/claude-opus-4.6

# Baidu Unlimited-OCR API endpoint
# BAIDU_UNLIMITED_OCR_ENDPOINT=https://your-ocr-endpoint/v1/chat/completions

# -----------------------------------------------------------------------------
# Durable Claude Agent Worker (Step 5) — all optional, server-side protections
# -----------------------------------------------------------------------------
# Run the durable background worker that drains agent_runs from PostgreSQL.
# Defaults ON when DATA_BACKEND=postgres, OFF otherwise.
# AGENT_WORKER_ENABLED=true
# Also execute a run inline at POST /api/agent/messages (single-process dev).
# Automatically skipped when the durable worker owns the queue; set false to disable.
# AGENT_INLINE_DISPATCH=true
# Lease (heartbeat) window before a 'running' run is treated as dead (seconds).
# AGENT_LEASE_SECONDS=120
# Wall-clock maximum execution time per run (seconds).
# AGENT_RUN_TIMEOUT_SECONDS=180
# Max durable attempts before a stale run is failed permanently.
# AGENT_MAX_ATTEMPTS=3
# Max characters retained per tool result (oversized results are truncated).
# AGENT_MAX_TOOL_RESULT_CHARS=12000
# Aggregate output-token budget across all Claude turns in one run.
# AGENT_MAX_TOTAL_OUTPUT_TOKENS=8192
