# LedgerLens Backend Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit real credentials to version control.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Cloud PostgreSQL persistence (REQUIRED for persistent production deployment).
# When DATA_BACKEND=postgres, DATABASE_URL must point to an active PostgreSQL instance.
DATA_BACKEND=postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/ledgerlens

# For hermetic local testing without external infrastructure, you may use:
# DATA_BACKEND=memory
# (Note: In-memory mode does NOT persist data across application restarts.)

# -----------------------------------------------------------------------------
# AI Providers (Optional / As Configured)
# -----------------------------------------------------------------------------
# FAL AI Key for Claude Opus document understanding
# FAL_KEY=your-fal-key-here
# FAL_ENDPOINT=https://fal.run/openrouter/router/openai/v1/chat/completions
# CLAUDE_MODEL=anthropic/claude-opus-4.6

# Baidu Unlimited-OCR API endpoint
# BAIDU_UNLIMITED_OCR_ENDPOINT=https://your-ocr-endpoint/v1/chat/completions
