# =============================================================================
# LedgerLens V1 — STAGING environment template (PLACEHOLDERS ONLY — no secrets)
# =============================================================================
# Derivation: every value below is read by the actual backend code
# (grep of os.environ across backend/*.py). Fill placeholders from your staging
# secret manager / platform UI. Do NOT commit real values.
#
# Legend:  [REQUIRED] must be set for staging to run
#          [FEATURE]  required only to enable that capability (else app degrades safely)
#          [OPTIONAL] has a safe default
# =============================================================================

# ---- Core runtime ----
ENVIRONMENT=production                     # [REQUIRED] activates fail-closed security guards
DATA_BACKEND=postgres                      # [REQUIRED] authoritative Postgres source of truth
PORT=8001                                  # [OPTIONAL] Dockerfile default 8001; set to match your PaaS
HOST=0.0.0.0                               # [OPTIONAL] listen host inside container

# ---- Auth / security ----
AUTH_SECRET_KEY=<STAGING_JWT_SIGNING_SECRET_MIN_32_CHARS>   # [REQUIRED] HS256 key; random, >=32 chars; NOT a placeholder value
ACCESS_TOKEN_EXPIRE_MINUTES=15             # [OPTIONAL]
REFRESH_TOKEN_EXPIRE_DAYS=7                # [OPTIONAL]
CORS_ORIGINS=https://staging.ledgerlens.example.com          # [REQUIRED] EXACT frontend origin(s), comma-separated; no '*' with credentials
TRUST_PROXY=true                           # [OPTIONAL] parse X-Forwarded-For behind a trusted proxy
LOGIN_MAX_ATTEMPTS=5                       # [OPTIONAL]
LOGIN_WINDOW_SECONDS=900                   # [OPTIONAL]

# ---- Database: MANAGED PostgreSQL (primary path) ----
# Create a managed Postgres DB; pre-create the database and a role with CREATE (startup
# DDL is idempotent: it creates tables + indexes; no migration tool). Fill these in:
DATABASE_URL=postgresql://<PG_USER>:<PG_PASSWORD>@<PG_HOST>:5432/<PG_DATABASE>?sslmode=require   # [REQUIRED]
#   <PG_HOST>/<PG_PORT>/<PG_DATABASE>/<PG_USER>/<PG_PASSWORD> all come from your managed-PG provider.
#   (Self-hosted-Postgres docker-compose variant — including POSTGRES_DB/USER/PASSWORD + a pgdata
#    volume — is documented in deploy/README.staging.md "Appendix: self-hosted DB".)


# ---- Object storage: Cloudflare R2 (S3-compatible) (primary path) ----
STORAGE_BACKEND=s3                         # [REQUIRED] with DATABASE_URL set, storage FAILS-CLOSED unless s3
S3_BUCKET=<R2_BUCKET_NAME>                 # [REQUIRED] the R2 bucket (private; app fetches by key, no public URL)
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>       # [REQUIRED] from an R2 API token (S3-compatible)
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>  # [REQUIRED] from the same R2 API token
S3_REGION=auto                             # [REQUIRED] R2 accepts 'auto'
S3_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com   # [REQUIRED for R2] account id from the R2 dashboard
# Leave unset for R2/S3 (Emergent proxy route is dev-only):
# EMERGENT_LLM_KEY=, INTEGRATION_PROXY_URL=


# ---- Claude (agent orchestrator + scan LLM assist) ----
FAL_KEY=<STAGING_FAL_KEY>                  # [FEATURE] agent answers + LLM-assisted scans (OpenRouter proxy; auth "Key $FAL_KEY")
FAL_ENDPOINT=https://fal.run/openrouter/router/openai/v1/chat/completions  # [OPTIONAL] default shown
CLAUDE_MODEL=anthropic/claude-opus-4.6     # [OPTIONAL] current default (do NOT pin retired claude-3-opus)
LLM_TIMEOUT=60                             # [OPTIONAL]
LLM_MAX_TOKENS=4096                        # [OPTIONAL]
# Direct-Anthropic fallback (optional redundancy instead of fal): ANTHROPIC_API_KEY=, ANTHROPIC_ENDPOINT=, ANTHROPIC_MODEL=

# ---- PaddleOCR (image/scanned documents, local execution) ----
PADDLE_OCR_USE_GPU=false                       # [OPTIONAL] default false (runs on CPU)
PADDLE_OCR_LANG=en                             # [OPTIONAL] language code (default: en)
PADDLE_OCR_USE_ANGLE_CLS=true                  # [OPTIONAL] orientation classifier (default: true)

# ---- Rate limits (per tenant) ----
RATE_LIMIT_FILES_PER_MIN=60                # [OPTIONAL]
RATE_LIMIT_SCANS_PER_MIN=30                # [OPTIONAL]
RATE_LIMIT_MESSAGES_PER_MIN=60             # [OPTIONAL]

# ---- Durable agent worker + limits ----
AGENT_WORKER_ENABLED=true                  # [OPTIONAL] default true when DATA_BACKEND=postgres (durable drain)
AGENT_INLINE_DISPATCH=false                # [OPTIONAL] auto-off when worker owns the queue
AGENT_LEASE_SECONDS=120                    # [OPTIONAL] lease before a running run is deemed dead
AGENT_RUN_TIMEOUT_SECONDS=180              # [OPTIONAL] wall-clock cap per run
AGENT_MAX_ATTEMPTS=3                        # [OPTIONAL] requeue attempts before fail
AGENT_MAX_TOOL_RESULT_CHARS=12000          # [OPTIONAL] oversized tool results truncated
AGENT_MAX_TOTAL_OUTPUT_TOKENS=8192         # [OPTIONAL] aggregate output-token budget per run

# ---- Frontend build-time (NOT backend runtime; set when building the SPA) ----
# REACT_APP_BACKEND_URL=https://api.staging.ledgerlens.example.com
