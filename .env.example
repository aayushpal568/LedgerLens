# =============================================================================
# LedgerLens Production Environment Configuration
# Copy this file to backend/.env and configure secrets before starting services.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Security & Authentication (Required)
# -----------------------------------------------------------------------------
# High-entropy secret key for signing HS256 JWT access tokens (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Allowed CORS origins (comma-separated). Never use '*' with credentials.
# Example: http://localhost:3000,https://app.ledgerlens.com
CORS_ORIGINS=http://localhost:3000

# Access token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-force login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Set to true when running behind a trusted reverse proxy (Nginx, ALB, Cloudflare)
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://ledgerlens:password@localhost:5432/ledgerlens

# Storage backend: "postgres" for production, "memory" for local unit testing
DATA_BACKEND=postgres

# -----------------------------------------------------------------------------
# 3. Production Object Storage (S3 / Cloudflare R2)
# -----------------------------------------------------------------------------
# Name of the S3 or R2 bucket storing tenant accounting documents
S3_BUCKET=

# AWS/S3 region (default: us-east-1)
S3_REGION=us-east-1

# Custom endpoint URL for Cloudflare R2, MinIO, or LocalStack
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# S3 / R2 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local storage fallback: set to "local" ONLY for offline local development
STORAGE_BACKEND=

# -----------------------------------------------------------------------------
# 4. LLM & Reasoning (Claude Opus via fal.ai or Anthropic)
# -----------------------------------------------------------------------------
# fal.ai API key for Claude Opus inference
FAL_KEY=

# fal.ai endpoint
FAL_ENDPOINT=https://fal.run/openrouter/router/openai/v1/chat/completions

# Model identifier
CLAUDE_MODEL=anthropic/claude-opus-4.6

# Optional direct Anthropic API key (fallback or alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-3-opus-20240229

# LLM request timeouts (seconds)
LLM_TIMEOUT=60
LLM_SHORT_TIMEOUT=15

# -----------------------------------------------------------------------------
# 5. Optical Character Recognition (Local PaddleOCR)
# -----------------------------------------------------------------------------
# Local execution on the user machine; defaults to CPU (no GPU required).
# Set to true only if GPU/CUDA acceleration is supported and desired.
PADDLE_OCR_USE_GPU=false
# Language code (default: en)
PADDLE_OCR_LANG=en
# Text orientation classifier (default: true)
PADDLE_OCR_USE_ANGLE_CLS=true

# -----------------------------------------------------------------------------
# 6. Server Runtime
# -----------------------------------------------------------------------------
PORT=8001
HOST=127.0.0.1
